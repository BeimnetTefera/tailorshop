msgid_plural "Ensure that there are no more than %(max)s digits in total."
msgstr[0] "በጠቅላላ ከ%(max)s አሃዝ መብለጥ የለበትም።"
msgstr[1] "በጠቅላላ ከ%(max)s አሃዞች መብለጥ የለበትም።"

#. From Django
msgid "Ensure that there are no more than %(max)s decimal place."
msgid_plural "Ensure that there are no more than %(max)s decimal places."
msgstr[0] "ከ%(max)s የአስርዮሽ ቦታ መብለጥ የለበትም።"
msgstr[1] "ከ%(max)s የአስርዮሽ ቦታዎች መብለጥ የለበትም።"

#. From Django
msgid "Ensure this value has at most %(limit_value)d character (it has %(show_value)d)."
msgid_plural "Ensure this value has at most %(limit_value)d characters (it has %(show_value)d)."
msgstr[0] "ከ%(limit_value)d ፊደል መብለጥ የለበትም (አሁን %(show_value)d አለው)።"
msgstr[1] "ከ%(limit_value)d ፊደላት መብለጥ የለበትም (አሁን %(show_value)d አለው)።"

#. From Django
msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "ይህ የይለፍ ቃል በጣም አጭር ነው። ቢያንስ %d ፊደል ሊኖረው ይገባል።"
msgstr[1] "ይህ የይለፍ ቃል በጣም አጭር ነው። ቢያንስ %d ፊደላት ሊኖሩት ይገባል።"

#. From Django
msgid "This password is too common."
msgstr "ይህ የይለፍ ቃል በጣም የተለመደ ነው።"

#. From Django
msgid "This password is entirely numeric."
msgstr "ይህ የይለፍ ቃል ቁጥር ብቻ ነው።"

#. From Django
msgid "The password is too similar to the %(verbose_name)s."
msgstr "የይለፍ ቃሉ ከ%(verbose_name)s ጋር በጣም ይመሳሰላል።"

#. From Django
msgid "username"
msgstr "የተጠቃሚ ስም"

#. From Django
msgid "first name"
msgstr "ስም"

#. From Django
msgid "last name"
msgstr "የአባት ስም"

#. From Django
msgid "email address"
msgstr "ኢሜይል"
